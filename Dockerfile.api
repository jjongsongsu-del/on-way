# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS builder

WORKDIR /workspace

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN --mount=type=cache,id=sea-load-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --trust-lockfile

COPY apps/api apps/api
COPY packages/shared packages/shared
COPY ref_api/크루즈 ref_api/크루즈

RUN pnpm --filter @badagil/shared build
RUN pnpm --filter @badagil/api db:generate
RUN pnpm --filter @badagil/api build

FROM node:22-alpine AS runtime

WORKDIR /workspace

ENV NODE_ENV=production
ENV API_PORT=4000

COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /workspace/apps/api/dist ./apps/api/dist
COPY --from=builder /workspace/apps/api/prisma ./apps/api/prisma
COPY --from=builder /workspace/apps/api/package.json ./apps/api/package.json
COPY --from=builder /workspace/packages/shared ./packages/shared
COPY --from=builder /workspace/ref_api ./ref_api
COPY --from=builder /workspace/package.json ./package.json

EXPOSE 4000

CMD ["node", "apps/api/dist/apps/api/src/main.js"]
