{
  "name": "@badagil/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start": "node dist/apps/api/src/main.js",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "node prisma/prisma-cli.cjs generate",
    "db:migrate": "node prisma/prisma-cli.cjs migrate dev",
    "db:fix-vessel-detail-drift": "node prisma/fix-vessel-detail-drift.cjs",
    "db:release-migrate-lock": "node prisma/release-prisma-migrate-lock.cjs",
    "db:seed:islands": "node prisma/seed-island-master.cjs",
    "db:seed:ferry-routes": "node prisma/seed-ferry-route-master.cjs",
    "db:seed:licenses": "node prisma/seed-license-data.cjs",
    "db:seed:addresses": "node prisma/seed-address-master.cjs",
    "db:seed:forecast-locations": "node prisma/seed-forecast-location-master.cjs",
    "db:seed:travel-regions": "node prisma/seed-island-travel-region-master.cjs",
    "db:seed:recommended-islands": "node prisma/seed-recommended-islands.cjs",
    "db:seed:cruises": "node prisma/seed-cruise-data.cjs",
    "db:seed:vworld-islands": "node prisma/seed-vworld-island-features.cjs",
    "data:collect:travel-files": "node prisma/collect-data-go-kr-travel-files.cjs",
    "data:extract:travel-columns": "node prisma/extract-data-go-kr-column-info.cjs",
    "data:extract:travel-columns:pages": "node prisma/extract-data-go-kr-columns-from-pages.cjs",
    "data:analyze:travel-recommendation": "node prisma/analyze-travel-recommendation-data.cjs",
    "db:seed:travel-recommendation": "node prisma/seed-travel-recommendation-assets.cjs",
    "data:collect:boryeong-recommended-islands": "node prisma/collect-boryeong-recommended-islands.cjs"
  },
  "dependencies": {
    "@badagil/shared": "workspace:*",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "fast-xml-parser": "^5.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/express": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
