  lotAddress     String?  @map("lot_address")
  phone          String?
  permitDate     DateTime? @map("permit_date") @db.Date
  closeDate      DateTime? @map("close_date") @db.Date
  roomCount      Int?     @map("room_count")
  koreanRoomCount Int?    @map("korean_room_count")
  westernRoomCount Int?   @map("western_room_count")
