  sourceFile     String   @map("source_file")
  licenseType    String   @map("license_type")
  managementNo   String?  @map("management_no")
  placeName      String   @map("place_name")
  businessStatus String?  @map("business_status")
  detailStatus   String?  @map("detail_status")
  categoryName   String?  @map("category_name")
