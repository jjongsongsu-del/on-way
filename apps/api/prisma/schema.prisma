model IslandLicenseMatch {
  id                  String   @id
  islandKey           String   @map("island_key")
  islandName          String   @map("island_name")
  legalDongName       String?  @map("legal_dong_name")
  licenseGroup        String   @map("license_group")
  licenseTable        String   @map("license_table")
  licenseId           String   @map("license_id")
  matchType           String   @map("match_type")
  matchKeyword        String   @map("match_keyword")
  matchScore          Int      @map("match_score")
  verified            Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([islandKey, licenseGroup, licenseId])
  @@index([islandName, licenseGroup])
  @@index([licenseGroup, licenseId])
  @@map("island_license_match")
}

model IslandLicenseKeyword {
  id                  String   @id
  islandKey           String   @map("island_key")
  islandName          String   @map("island_name")
  legalDongName       String?  @map("legal_dong_name")
  matchKeyword        String   @map("match_keyword")
  normalizedKeyword   String   @map("normalized_keyword")
  sourceMatchCount    Int      @default(0) @map("source_match_count")
  verified            Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([islandKey, matchKeyword])
  @@index([islandName])
  @@index([legalDongName])
  @@index([matchKeyword])
  @@index([normalizedKeyword])
  @@map("island_license_keyword")
}

