  eupmyeondongSerialNo  String?  @map("eupmyeondong_serial_no")
  lotSubNo              Int?     @map("lot_sub_no")
  oldZipCode            String?  @map("old_zip_code")
  zipSerialNo           String?  @map("zip_serial_no")
  fullRoadAddress       String   @map("full_road_address")
  fullLotAddress        String   @map("full_lot_address")
  normalizedAddress     String   @map("normalized_address")
  marineRegionId        String?  @map("marine_region_id")
