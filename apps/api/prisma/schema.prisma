model TravelDataSource {
  publicDataPk      String   @id @map("public_data_pk")
  title             String
  organization      String?
  sourceKeywords    String[] @default([]) @map("source_keywords")
  formats           String[] @default([])
  localFilePath     String?  @map("local_file_path")
  fileSizeBytes     BigInt?  @map("file_size_bytes")
  columnCount       Int      @default(0) @map("column_count")
  sampleHeaders     String[] @default([]) @map("sample_headers")
  capabilities      Json?
  categories        String[] @default([])
  styleScores       Json?    @map("style_scores")
  usabilityScore    Int      @default(0) @map("usability_score")
  usabilityGrade    String   @default("D") @map("usability_grade")
  recommendationUse String   @default("metadata-only") @map("recommendation_use")
  reasons           String[] @default([])
  cautions          String[] @default([])
  rawInventory      Json?    @map("raw_inventory")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  assets            TravelAsset[]

  @@index([recommendationUse])
  @@index([usabilityScore])
  @@index([organization])
  @@map("travel_data_source")
}

model TravelAsset {
  id                String   @id
  sourceDatasetPk   String   @map("source_dataset_pk")
  sourceTitle       String   @map("source_title")
  sourceFilePath    String?  @map("source_file_path")
  sourceRowIndex    Int?     @map("source_row_index")
  name              String
  category          String?
  province          String?
  city              String?
  legalDongName     String?  @map("legal_dong_name")
  address           String?
  latitude          Float?
  longitude         Float?
  matchedIslandId   String?  @map("matched_island_id")
  matchedIslandName String?  @map("matched_island_name")
  travelRegionId    String?  @map("travel_region_id")
  travelRegionName  String?  @map("travel_region_name")
  matchType         String?  @map("match_type")
  matchScore        Int      @default(0) @map("match_score")
  tags              String[] @default([])
  evidence          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  source            TravelDataSource @relation(fields: [sourceDatasetPk], references: [publicDataPk], onDelete: Cascade)
  matches           TravelAssetMatch[]

  @@index([sourceDatasetPk])
  @@index([name])
  @@index([category])
  @@index([province, city])
  @@index([travelRegionId])
  @@index([matchedIslandId])
  @@index([matchScore])
  @@map("travel_asset")
}

model TravelAssetMatch {
  id               String   @id
  travelAssetId    String   @map("travel_asset_id")
  targetType       String   @map("target_type")
  targetId         String?  @map("target_id")
  targetName       String?  @map("target_name")
  matchType        String   @map("match_type")
  matchScore       Int      @default(0) @map("match_score")
  evidence         Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  asset            TravelAsset @relation(fields: [travelAssetId], references: [id], onDelete: Cascade)

  @@index([travelAssetId])
  @@index([targetType, targetId])
  @@index([matchScore])
  @@map("travel_asset_match")
}

