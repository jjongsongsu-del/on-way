generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Route {
  id                 String            @id @default(cuid())
  licenseRouteCode   String?           @map("license_route_code")
  licenseRouteName   String?           @map("license_route_name")
  operationRouteCode String?           @map("operation_route_code")
  operationRouteName String            @map("operation_route_name")
  provider           String
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  stops              RouteStop[]
  schedules          SailingSchedule[]
  forecasts          SailingForecast[]

  @@index([provider, operationRouteCode])
  @@map("route")
}

model RouteStop {
  id           String   @id @default(cuid())
  routeId      String   @map("route_id")
  stopSequence Int      @map("stop_sequence")
  portCode     String?  @map("port_code")
  portName     String   @map("port_name")
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  route        Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  port         Port?    @relation(fields: [portCode], references: [portCode])

  @@index([routeId, stopSequence])
  @@map("route_stop")
}

model Port {
  id         String      @id @default(cuid())
  portCode   String      @unique @map("port_code")
  portName   String      @map("port_name")
  regionName String?     @map("region_name")
  latitude   Decimal?    @db.Decimal(10, 7)
  longitude  Decimal?    @db.Decimal(10, 7)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  routeStops RouteStop[]
  terminals  Terminal[]

  @@index([portName])
  @@map("port")
}

model Terminal {
  id           String   @id @default(cuid())
  portId       String?  @map("port_id")
  terminalCode String?  @map("terminal_code")
  terminalName String   @map("terminal_name")
  address      String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  mapUrl       String?  @map("map_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  port         Port?    @relation(fields: [portId], references: [id])

  @@index([terminalName])
  @@map("terminal")
}

model Vessel {
  id                String            @id @default(cuid())
  vesselCode        String?           @map("vessel_code")
  vesselName        String            @map("vessel_name")
  passengerCapacity Int?              @map("passenger_capacity")
  operatorName      String?           @map("operator_name")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  schedules         SailingSchedule[]
  forecasts         SailingForecast[]

  @@map("vessel")
}

model VesselDetail {
  id                String   @id @default(cuid())
  shipNo            String   @unique @map("ship_no")
  vesselName        String   @map("vessel_name")
  imageUrl          String?  @map("image_url")
  imageDataUrl       String?  @map("image_data_url")
  sourceUrl         String   @map("source_url")
  grossTonnage      String?  @map("gross_tonnage")
  dimensions        String?
  shipType          String?  @map("ship_type")
  shipKind          String?  @map("ship_kind")
  maxSpeed          String?  @map("max_speed")
  cruiseSpeed       String?  @map("cruise_speed")
  engineType        String?  @map("engine_type")
  enginePower       String?  @map("engine_power")
  navigationArea    String?  @map("navigation_area")
  passengerCapacity String?  @map("passenger_capacity")
  routeName         String?  @map("route_name")
  operatorName      String?  @map("operator_name")
  collectedAt       DateTime @map("collected_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([vesselName])
  @@map("vessel_detail")
}

model IslandMaster {
  id                 String   @id @default(cuid())
  islandKey          String   @unique @map("island_key")
  legalDongCode      String   @map("legal_dong_code")
  legalDongName      String   @map("legal_dong_name")
  islandUniqueNo     String   @map("island_unique_no")
  islandName         String   @map("island_name")
  islandTypeCode     String?  @map("island_type_code")
  islandTypeName     String?  @map("island_type_name")
  connectionTypeCode String?  @map("connection_type_code")
  connectionTypeName String?  @map("connection_type_name")
  bridgeCount        Int?     @map("bridge_count")
  bridgeNames        String?  @map("bridge_names")
  referenceDate      DateTime @map("reference_date") @db.Date
  sourceRegionCode   String?  @map("source_region_code")
  forecastLocationId String?  @map("forecast_location_id")
  forecastLocationName String? @map("forecast_location_name")
  forecastMatchType  String?  @map("forecast_match_type")
  forecastMatchScore Int?     @map("forecast_match_score")
  travelRegionId     String?  @map("travel_region_id")
  travelRegionName   String?  @map("travel_region_name")
  travelRegionMatchType String? @map("travel_region_match_type")
  travelRegionMatchScore Int? @map("travel_region_match_score")
  vworldFeatureId    String?  @map("vworld_feature_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([islandName])
  @@index([legalDongName])
  @@index([islandTypeName])
  @@index([forecastLocationId])
  @@index([travelRegionId])
  @@index([vworldFeatureId])
  @@map("island_master")
}

model IslandTravelRegionMaster {
  id                    String   @id
  version               String   @default("1.0")
  name                  String
  group                 String   @map("region_group")
  description           String?
  provinceNames         String[] @map("province_names")
  cityNames             String[] @map("city_names")
  mainPortNames         String[] @map("main_port_names")
  aliases               String[]
  primaryForecastRegionId String? @map("primary_forecast_region_id")
  forecastRegionIds     String[] @map("forecast_region_ids")
  centerLatitude        Decimal? @map("center_latitude") @db.Decimal(10, 7)
  centerLongitude       Decimal? @map("center_longitude") @db.Decimal(10, 7)
  sortOrder             Int      @map("sort_order")
  sourceNote            String   @map("source_note")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([group])
  @@index([primaryForecastRegionId])
  @@map("island_travel_region")
}

model MarineForecastLocationMaster {
  id                 String  @id
  label              String
  helper             String
  kind               String
  aliases            String[]
  nx                 Int
  ny                 Int
  stationCode        String  @map("station_code")
  stationName        String  @map("station_name")
  salinityGridCode   String? @map("salinity_grid_code")
  latitude           Decimal? @db.Decimal(10, 7)
  longitude          Decimal? @db.Decimal(10, 7)
  sourceNote         String  @map("source_note")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([label])
  @@map("marine_forecast_location")
}

model VworldIslandFeature {
  id                 String   @id
  islandUniqueNo     String?  @map("island_unique_no")
  islandName         String   @map("island_name")
  legalDongCode      String?  @map("legal_dong_code")
  legalDongName      String?  @map("legal_dong_name")
  provinceName       String?  @map("province_name")
  cityName           String?  @map("city_name")
  latitude           Decimal? @db.Decimal(10, 7)
  longitude          Decimal? @db.Decimal(10, 7)
  areaSquareMeters   Decimal? @map("area_square_meters") @db.Decimal(18, 3)
  coastlineLengthMeters Decimal? @map("coastline_length_meters") @db.Decimal(18, 3)
  population         Int?
  raw                Json
  fetchedAt          DateTime @map("fetched_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([islandUniqueNo])
  @@index([islandName])
  @@index([legalDongCode])
  @@map("vworld_island_feature")
}

model FerryRouteMaster {
  id                String   @id @default(cuid())
  routeKey          String   @map("route_key")
  routePairKey      String   @unique @map("route_pair_key")
  routeName         String   @map("route_name")
  normalizedRouteName String @map("normalized_route_name")
  departurePortName String   @map("departure_port_name")
  arrivalPortName   String   @map("arrival_port_name")
  stopPortNames     String[] @map("stop_port_names")
  vesselNames       String[] @map("vessel_names")
  operatorNames     String[] @map("operator_names")
  waypointCount     Int      @default(0) @map("waypoint_count")
  minLatitude       Decimal? @map("min_latitude") @db.Decimal(10, 7)
  maxLatitude       Decimal? @map("max_latitude") @db.Decimal(10, 7)
  minLongitude      Decimal? @map("min_longitude") @db.Decimal(10, 7)
  maxLongitude      Decimal? @map("max_longitude") @db.Decimal(10, 7)
  source            String
  referenceDate     DateTime @map("reference_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([routeKey])
  @@index([departurePortName])
  @@index([arrivalPortName])
  @@index([routeName])
  @@map("ferry_route_master")
}

model FerryPortMaster {
  id                  String   @id @default(cuid())
  portKey             String   @unique @map("port_key")
  portName            String   @map("port_name")
  normalizedPortName  String   @map("normalized_port_name")
  routeCount          Int      @default(0) @map("route_count")
  departureRouteCount Int      @default(0) @map("departure_route_count")
  arrivalRouteCount   Int      @default(0) @map("arrival_route_count")
  islandKey           String?  @map("island_key")
  islandName          String?  @map("island_name")
  legalDongName       String?  @map("legal_dong_name")
  forecastLocationId  String?  @map("forecast_location_id")
  forecastLocationName String? @map("forecast_location_name")
  source              String
  referenceDate       DateTime @map("reference_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([portName])
  @@index([normalizedPortName])
  @@index([islandName])
  @@map("ferry_port_master")
}

