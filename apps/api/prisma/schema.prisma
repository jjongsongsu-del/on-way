  bulkDeliveryName      String?  @map("bulk_delivery_name")
  buildingName          String?  @map("building_name")
  legalDongCode         String?  @map("legal_dong_code")
  legalDongName         String?  @map("legal_dong_name")
  riName                String?  @map("ri_name")
  administrativeDongName String? @map("administrative_dong_name")
  mountainFlag          Boolean  @default(false) @map("mountain_flag")
