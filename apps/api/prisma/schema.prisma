model SailingSchedule {
  id                String            @id @default(cuid())
  sailingDate       DateTime          @map("sailing_date") @db.Date
  departureTime     String            @map("departure_time")
  departurePortName String            @map("departure_port_name")
  arrivalPortName   String            @map("arrival_port_name")
  routeId           String?           @map("route_id")
  vesselId          String?           @map("vessel_id")
  controlReason     String?           @map("control_reason")
  passengerCapacity Int?              @map("passenger_capacity")
  status            SailingStatusCode @default(UNKNOWN)
  source            String
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  route             Route?            @relation(fields: [routeId], references: [id])
  vessel            Vessel?           @relation(fields: [vesselId], references: [id])
  statuses          SailingStatus[]

  @@index([sailingDate, departurePortName, arrivalPortName])
  @@map("sailing_schedule")
}

model SailingStatus {
  id            String            @id @default(cuid())
  scheduleId    String?           @map("schedule_id")
  sailingDate   DateTime          @map("sailing_date") @db.Date
  vesselName    String?           @map("vessel_name")
  routeName     String?           @map("route_name")
  statusCode    SailingStatusCode @default(UNKNOWN) @map("status_code")
  statusName    String            @map("status_name")
  delayMinutes  Int?              @map("delay_minutes")
  controlReason String?           @map("control_reason")
  source        String
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  schedule      SailingSchedule?  @relation(fields: [scheduleId], references: [id])

  @@index([sailingDate, statusCode])
  @@map("sailing_status")
}

model SailingForecast {
  id             String             @id @default(cuid())
  forecastDate   DateTime           @map("forecast_date") @db.Date
  routeId        String?            @map("route_id")
  vesselId       String?            @map("vessel_id")
  forecastStatus ForecastStatusCode @default(UNKNOWN) @map("forecast_status")
  forecastReason String?            @map("forecast_reason")
  weatherSummary String?            @map("weather_summary")
  riskLevel      RiskLevel          @default(UNKNOWN) @map("risk_level")
  source         String
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  route          Route?             @relation(fields: [routeId], references: [id])
  vessel         Vessel?            @relation(fields: [vesselId], references: [id])

  @@index([forecastDate, forecastStatus])
  @@map("sailing_forecast")
}

model UserFavorite {
  id                  String       @id @default(cuid())
  userId              String       @map("user_id")
  favoriteType        FavoriteType @map("favorite_type")
  targetId            String       @map("target_id")
  notificationEnabled Boolean      @default(true) @map("notification_enabled")
  createdAt           DateTime     @default(now()) @map("created_at")

  @@index([userId, favoriteType])
  @@map("user_favorite")
}

model DeviceUser {
  id         String      @id @default(cuid())
  deviceId   String      @unique @map("device_id")
  platform   Platform
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  pushTokens PushToken[]

  @@map("device_user")
}

model PushToken {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  token      String       @unique
  provider   PushProvider
  platform   Platform
  enabled    Boolean      @default(true)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  deviceUser DeviceUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@map("push_token")
}

