model CruisePort {
  id              String   @id @default(cuid())
  portKey         String   @unique @map("port_key")
  portName        String   @map("port_name")
  regionName      String?  @map("region_name")
  cityName        String?  @map("city_name")
  terminalName    String?  @map("terminal_name")
  sourceName      String   @map("source_name")
  sourceUrl       String?  @map("source_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  schedules       CruiseSchedule[]
  tourProducts    CruiseTourProduct[]
  operatorLicenses CruiseOperatorLicense[]

  @@index([portName])
  @@index([regionName])
  @@map("cruise_port")
}

model CruiseVessel {
  id                String   @id @default(cuid())
  vesselKey         String   @unique @map("vessel_key")
  vesselName        String   @map("vessel_name")
  operatorName      String?  @map("operator_name")
  registryCountry   String?  @map("registry_country")
