# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS builder

WORKDIR /workspace

ENV CI=true

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY index.js metro.config.js ./
COPY apps/api/package.json apps/api/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN --mount=type=cache,id=sea-load-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --trust-lockfile

COPY apps/mobile apps/mobile
COPY packages/shared packages/shared

ARG EXPO_PUBLIC_API_BASE_URL=/api/v1
ENV EXPO_PUBLIC_API_BASE_URL=${EXPO_PUBLIC_API_BASE_URL}

RUN NODE_OPTIONS=--max-old-space-size=1536 pnpm --filter @badagil/mobile build:web

FROM nginx:1.27-alpine AS runtime

COPY deploy/nginx/sea-load.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/mobile/dist /usr/share/nginx/html

EXPOSE 80
